<Window x:Class="ResolumeConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resolume Arena Configurator" SizeToContent="Height" Width="1460" MaxHeight="900" MinHeight="760" MinWidth="1120"
        Background="{StaticResource AppBackground}" Icon="Assets/app-icon.png" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#242829"/><Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Padding" Value="18"/><Setter Property="BorderBrush" Value="#3B4142"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A9B1B2"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="OptionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#EEF2F2"/>
    </Style>
    <Style x:Key="OptionHelp" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#8E999B"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#202324" BorderBrush="#3A3F40" BorderThickness="0,0,0,1" Padding="24,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="46" Height="46" Background="#171A1B" BorderBrush="#444B4C" BorderThickness="1" Margin="0,0,13,0">
          <Image Source="Assets/app-icon.png" Width="40" Height="40" Stretch="Uniform"/>
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock Text="RESOLUME ARENA CONFIGURATOR" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11"/>
          <TextBlock Text="Build workspace from NDI job" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"/>
          <TextBlock x:Name="ConfigurationSummaryText" Text="4K  ·  50 FPS  ·  20 COLUMNS" Foreground="#9BA5A7" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#183C33" BorderBrush="#286252" BorderThickness="1" Padding="11,6" Margin="0,0,7,0"><TextBlock x:Name="JobStatusText" Text="NDI JOB: CHECKING…" Foreground="#7CEBCB" FontSize="11" FontWeight="SemiBold"/></Border>
          <Border Background="#303536" BorderBrush="#464D4F" BorderThickness="1" Padding="11,6"><TextBlock x:Name="ArenaStatusText" Text="ARENA: CHECKING…" Foreground="#C5CCCD" FontSize="11" FontWeight="SemiBold"/></Border>
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Margin="24,18,24,20">
        <Grid x:Name="ConfigurationInputs">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="JOB DEVICES" Style="{StaticResource Label}" Margin="0,0,0,14"/>
              <DockPanel Margin="0,0,0,7">
                <TextBlock Text="DECODER OUTPUTS" Style="{StaticResource OptionTitle}" VerticalAlignment="Center"/>
                <TextBlock x:Name="DecoderCountText" DockPanel.Dock="Right" Text="0" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
              </DockPanel>
              <DataGrid x:Name="DecoderGrid" ItemsSource="{Binding Decoders}" Height="160" AlternationCount="2">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="36" IsReadOnly="True"/>
                  <DataGridTextColumn Header="OUTPUT / GROUP" Binding="{Binding OutputName}" Width="*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="105" IsReadOnly="True"/>
                  <DataGridTextColumn Header="W" Binding="{Binding Width, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}" Width="68"/>
                  <DataGridTextColumn Header="H" Binding="{Binding Height, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True}" Width="68"/>
                  <DataGridTextColumn Header="SOURCE" Binding="{Binding ResolutionStatus}" Width="76" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
              <DockPanel Margin="0,16,0,7">
                <TextBlock Text="ENCODER SOURCES" Style="{StaticResource OptionTitle}" VerticalAlignment="Center"/>
                <TextBlock x:Name="EncoderCountText" DockPanel.Dock="Right" Text="0" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
              </DockPanel>
              <DataGrid x:Name="EncoderGrid" ItemsSource="{Binding Encoders}" Height="160" AlternationCount="2">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="36" IsReadOnly="True"/>
                  <DataGridTextColumn Header="ENCODER" Binding="{Binding DeviceLabel}" Width="*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="ARENA NDI SOURCE" Binding="{Binding ArenaSourceName, UpdateSourceTrigger=PropertyChanged}" Width="1.25*"/>
                  <DataGridTextColumn Header="MATCH" Binding="{Binding MatchStatus}" Width="82" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
              <Grid Margin="0,9,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="EncoderMatchWarningText" Text="Missing or ambiguous feeds: enter a unique, complete Arena source name."
                             Foreground="#F17878" FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" Margin="0,0,0,3"/>
                  <TextBlock Text="Decoder dimensions remain editable. Encoder source names can be corrected before configuration."
                             Style="{StaticResource OptionHelp}"/>
                </StackPanel>
                <Button x:Name="RefreshDetectionButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                        Content="REFRESH DETECTION / MATCHING" Click="RefreshDetectionButton_OnClick"
                        Padding="13,7" Margin="14,0,0,0" FontSize="11" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="WORKSPACE SETUP" Style="{StaticResource Label}" Margin="0,0,0,14"/>
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Resolution" Style="{StaticResource OptionTitle}"/>
                  <ComboBox x:Name="WorkspaceResolutionComboBox" ItemsSource="{Binding WorkspaceResolutions}" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Frame rate" Style="{StaticResource OptionTitle}"/>
                  <ComboBox x:Name="FrameRateComboBox" ItemsSource="{Binding FrameRates}" Margin="0,7,0,0"/>
                </StackPanel>
              </Grid>
              <Border BorderBrush="#3A4041" BorderThickness="0,1,0,0" Padding="0,15,0,14">
                <StackPanel>
                  <DockPanel>
                    <TextBlock Text="Composition columns" Style="{StaticResource OptionTitle}" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=ColumnCountSlider, Path=Value, StringFormat={}{0:0}}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                  </DockPanel>
                  <Slider x:Name="ColumnCountSlider" Minimum="5" Maximum="50" Value="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,4"/>
                  <TextBlock x:Name="ColumnCountHelpText" Text="Choose between 5 and 50 columns." Style="{StaticResource OptionHelp}"/>
                </StackPanel>
              </Border>
              <Border BorderBrush="#3A4041" BorderThickness="0,1,0,0" Padding="0,14">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="NDI composition sharing" Style="{StaticResource OptionTitle}"/>
                    <TextBlock Text="Broadcast Resolume's main composition over NDI after restart." Style="{StaticResource OptionHelp}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <ToggleButton x:Name="NdiCompositionSharingToggle" Grid.Column="1" Style="{StaticResource PillToggle}" IsChecked="False" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Border BorderBrush="#3A4041" BorderThickness="0,1,0,0" Padding="0,14">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Auto-place NDI sources" Style="{StaticResource OptionTitle}"/>
                    <TextBlock Text="Load matched encoder feeds into every Primary, Secondary, Holding and Show layer." Style="{StaticResource OptionHelp}" Margin="0,3,0,0"/>
                  </StackPanel>
                  <ToggleButton x:Name="AutoPlaceSourcesToggle" Grid.Column="1" Style="{StaticResource PillToggle}" IsChecked="True" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Border BorderBrush="#3A4041" BorderThickness="0,1,0,0" Padding="0,15,0,0" IsEnabled="{Binding ElementName=AutoPlaceSourcesToggle, Path=IsChecked}">
                <StackPanel>
                  <DockPanel>
                    <TextBlock Text="Source Placement Starting Position" Style="{StaticResource OptionTitle}" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=SourceStartColumnSlider, Path=Value, StringFormat={}{0:0}}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Right"/>
                  </DockPanel>
                  <Slider x:Name="SourceStartColumnSlider" Minimum="1" Maximum="20" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,4"/>
                  <TextBlock Text="The Video Router uses the next column after the placed sources." Style="{StaticResource OptionHelp}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="ACTIVITY" Style="{StaticResource Label}"/>
            <TextBox x:Name="LogBox" Margin="0,8,0,0" Height="96" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
          </StackPanel>
        </Border>
      </StackPanel>

    <Border Grid.Row="2" Background="#202324" BorderBrush="#3A3F40" BorderThickness="0,1,0,0" Padding="24,13">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ProgressBar x:Name="ConfigurationProgress" Grid.ColumnSpan="2" Height="4" Margin="0,0,0,11" Minimum="0" Maximum="100" Value="0" Background="#353A3B" Foreground="{StaticResource AccentBrush}"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
          <TextBlock x:Name="ValidationText" Text="Waiting for discovery." FontWeight="SemiBold"/>
          <TextBlock Text="Configure saves a backup, then overwrites the open composition. Secondary and Holding layers will be collapsed." Foreground="#D6A75B" FontSize="11" Margin="0,2,0,0"/>
          <TextBlock Text="© 2026 John Lightfoot · Proprietary software · Free for non-commercial use" Foreground="#717B7D" FontSize="10" Margin="0,2,0,0"/>
        </StackPanel>
        <Button x:Name="ConfigureButton" Grid.Row="1" Grid.Column="1" Content="CONFIGURE ARENA" Click="ConfigureButton_OnClick" IsEnabled="False" Padding="24,11"/>
      </Grid>
    </Border>
  </Grid>
</Window>
