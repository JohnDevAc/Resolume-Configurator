<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Resolume Arena Configurator</AssemblyName>
    <RootNamespace>ResolumeConfigurator</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <Product>Resolume Arena Configurator</Product>
    <Description>Build Resolume Arena compositions and Advanced Output routes from NDI Job Configurator jobs.</Description>
    <Authors>John Lightfoot</Authors>
    <Company>John Lightfoot</Company>
    <Copyright>Copyright © 2026 John Lightfoot. All rights reserved.</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Version>0.3.7</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ResolumeConfigurator.Tests" />
    <Resource Include="Assets\app-icon.png" />
    <None Include="..\..\LICENSE" Link="LICENSE" Pack="true" PackagePath="" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
